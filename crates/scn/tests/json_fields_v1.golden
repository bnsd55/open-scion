# The JSON fields `scn` promises in 1.x (additive-only): one line per
# command and field path, `command path:type`. The check runs the binary
# and asserts this list is still all there; new fields pass, a removed
# field or a changed type fails (docs/stability.md, 1.x).
log log[0].author.email:string
log log[0].author.name:string
log log[0].author.tz_offset_minutes:number
log log[0].author.unix_secs:number
log log[0].committer.email:string
log log[0].committer.name:string
log log[0].committer.tz_offset_minutes:number
log log[0].committer.unix_secs:number
log log[0].id:string
log log[0].message:string
log log[0].parents[0]:string
ls ls[0].executable:boolean
ls ls[0].id:string
ls ls[0].kind:string
ls ls[0].name:string
ls ls[0].size:number
show show.author.email:string
show show.author.name:string
show show.author.tz_offset_minutes:number
show show.author.unix_secs:number
show show.changes[0].executable:boolean
show show.changes[0].id:string
show show.changes[0].kind:string
show show.changes[0].op:string
show show.changes[0].path:string
show show.committer.email:string
show show.committer.name:string
show show.committer.tz_offset_minutes:number
show show.committer.unix_secs:number
show show.id:string
show show.message:string
show show.parents[0]:string
blame blame[0].author.email:string
blame blame[0].author.name:string
blame blame[0].author.tz_offset_minutes:number
blame blame[0].author.unix_secs:number
blame blame[0].changeset:string
blame blame[0].line_count:number
blame blame[0].origin_line:number
blame blame[0].path:string
blame blame[0].start_line:number
diff diff[0].new.executable:boolean
diff diff[0].new.id:string
diff diff[0].new.kind:string
diff diff[0].new.size:number
diff diff[0].old.executable:boolean
diff diff[0].old.id:string
diff diff[0].old.kind:string
diff diff[0].old.size:number
diff diff[0].path:string
diff diff[0].status:string
merge-base merge-base[0]:string
commit commit.changeset:string
land land.conflict_paths:array
land land.detail:string
land land.land_id:string
land land.result:string
land land.state:string
is-ancestor is-ancestor.is_ancestor:boolean
