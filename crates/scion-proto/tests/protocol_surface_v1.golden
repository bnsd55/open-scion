# The protocol v1 surface that 1.x freezes (additive-only): one line per
# call, one per message field with its number and wire type. The check
# reads crates/scion-proto/proto/scion.proto and asserts this list is
# still all there; anything new passes, anything removed or renumbered
# fails (docs/stability.md, docs/compatibility.md).
BlameChangeset.author_email:3:bytes
BlameChangeset.author_name:2:bytes
BlameChangeset.author_tz_offset_minutes:5:int32
BlameChangeset.author_unix_secs:4:int64
BlameChangeset.changeset_id:1:bytes
BlameChangeset.path:6:bytes
BlameRange.changeset_id:3:bytes
BlameRange.line_count:2:uint32
BlameRange.origin_line:4:uint32
BlameRange.start_line:1:uint32
BlameRequest.changeset_id:2:bytes
BlameRequest.cursor:7:bytes
BlameRequest.path:3:bytes
BlameRequest.repo:1:string
BlameResponse.changesets:2:repeated BlameChangeset
BlameResponse.next_cursor:7:bytes
BlameResponse.ranges:1:repeated BlameRange
CreateChangesetRequest.changeset:2:bytes
CreateChangesetRequest.repo:1:string
CreateChangesetResponse.changeset_id:1:bytes
DiffEntry.new:3:FileState
DiffEntry.old:2:FileState
DiffEntry.path:1:bytes
DiffEntry.rename_from:4:bytes
DiffEntry.rename_to:5:bytes
DiffEntry.similarity:6:uint32
DiffRequest.after:5:bytes
DiffRequest.new_changeset_id:3:bytes
DiffRequest.old_changeset_id:2:bytes
DiffRequest.path:4:bytes
DiffRequest.repo:1:string
DiffResponse.entries:1:repeated DiffEntry
DiffResponse.next_after:2:bytes
DiffResponse.renames_incomplete:3:bool
FileState.executable:3:bool
FileState.id:2:bytes
FileState.kind:1:FileKind
GetChangesetRequest.changeset_id:2:bytes
GetChangesetRequest.repo:1:string
GetChangesetResponse.changeset:1:bytes
GetLandRequest.land_id:2:string
GetLandRequest.repo:1:string
GetObjectsRequest.accept:3:repeated Encoding
GetObjectsRequest.refs:2:repeated ObjectRef
GetObjectsRequest.ticket:4:bytes
GetRootTreeRequest.changeset_id:2:bytes
GetRootTreeRequest.repo:1:string
GetRootTreeResponse.ticket:2:bytes
GetRootTreeResponse.tree_id:1:bytes
IsAncestorRequest.ancestor_id:2:bytes
IsAncestorRequest.descendant_id:3:bytes
IsAncestorRequest.repo:1:string
IsAncestorResponse.is_ancestor:1:bool
LandRequest.changeset_id:2:bytes
LandRequest.repo:1:string
LandRequest.request_key:4:string
LandRequest.target_ref:3:string
LandResponse.conflict_paths:5:repeated bytes
LandResponse.detail:4:string
LandResponse.land_id:1:string
LandResponse.result_changeset_id:3:bytes
LandResponse.state:2:LandState
ListDirRequest.changeset_id:2:bytes
ListDirRequest.path:3:bytes
ListDirRequest.repo:1:string
ListDirResponse.tree:1:bytes
LogEntry.changeset:2:bytes
LogEntry.changeset_id:1:bytes
LogRequest.changeset_id:2:bytes
LogRequest.limit:3:uint32
LogRequest.path:4:bytes
LogRequest.repo:1:string
LogResponse.entries:1:repeated LogEntry
LogResponse.next_changeset_id:2:bytes
MergeBaseRequest.a_changeset_id:2:bytes
MergeBaseRequest.b_changeset_id:3:bytes
MergeBaseRequest.repo:1:string
MergeBaseResponse.changeset_ids:1:repeated bytes
ObjectPart.data:3:bytes
ObjectPart.encoded_size:5:uint64
ObjectPart.encoding:4:Encoding
ObjectPart.id:2:bytes
ObjectPart.kind:1:ObjectKind
ObjectPart.size:6:uint64
ObjectRef.id:2:bytes
ObjectRef.kind:1:ObjectKind
ObjectRef.path:3:bytes
Objects.GetObjects
Objects.GetRootTree
Objects.ResolveRef
PutBlobRequest.data:2:bytes
PutBlobRequest.repo:1:string
PutBlobResponse.blob_id:1:bytes
ReadFileRequest.changeset_id:2:bytes
ReadFileRequest.path:3:bytes
ReadFileRequest.repo:1:string
ReadFileResponse.data:1:bytes
ResolveRefRequest.name:2:string
ResolveRefRequest.repo:1:string
ResolveRefResponse.changeset_id:1:bytes
Scion.Blame
Scion.CreateChangeset
Scion.Diff
Scion.GetChangeset
Scion.GetLand
Scion.IsAncestor
Scion.Land
Scion.ListDir
Scion.Log
Scion.MergeBase
Scion.PutBlob
Scion.ReadFile
Scion.ResolveRef
